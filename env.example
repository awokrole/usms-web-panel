# PostgreSQL — ta sama baza co bot Railway
DATABASE_URL=

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_TOKEN=

# Publiczny adres Railway, np. https://usms-panel-production.up.railway.app
PUBLIC_URL=

# Wygeneruj losowy sekret, np. 64 znaki
WEB_SECRET_KEY=

# Role, które mają widzieć sekcje administracyjne. ID rozdziel przecinkami.
WEB_ADMIN_ROLE_IDS=

# Gemini API — Asystent zarzutów
GEMINI_API_KEY=
# Opcjonalnie; domyślnie aplikacja używa gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
